{
  "name": "easy-sync",
  "version": "1.5.0",
  "description": "EasySync / 易同步 — Obsidian OneDrive sync with minimal setup, clear status, and controlled conflict handling",
  "main": "main.js",
  "scripts": {
    "typecheck": "tsc -noEmit -skipLibCheck",
    "build": "tsc -noEmit -skipLibCheck && esbuild src/main.ts --bundle --external:obsidian --external:https --format=cjs --target=es2020 --outfile=main.js && node scripts/check-bundle-compat.cjs",
    "test": "vitest run",
    "test:performance": "vitest run tests/sync-performance-contract.test.ts tests/sync-safety.test.ts tests/plugin-data-cold-start.test.ts tests/startup-performance-contract.test.ts tests/community-plugin-enablement-runtime.test.ts -t \"A0-P|platform-neutral 500-file|V2 cold-start\" --reporter=verbose",
    "lint": "eslint .",
    "check:meta": "node C:/Users/jiaor/.codex/skills/obsidian-plugin-release-protection/scripts/check-metadata.mjs --project .",
    "check:lockfile": "pwsh -NoProfile -File scripts/check-lockfile-ci.ps1"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "sync",
    "onedrive"
  ],
  "author": "Jiao Yingxing",
  "homepage": "https://github.com/jiaoyingxing/easy-sync",
  "repository": {
    "type": "git",
    "url": "https://github.com/jiaoyingxing/easy-sync.git"
  },
  "bugs": {
    "url": "https://github.com/jiaoyingxing/easy-sync/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.24.0",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@types/node": "^26.1.0",
    "core-js-pure": "3.49.0",
    "idb": "^8.0.3",
    "obsidian": "1.13.1"
  }
}
