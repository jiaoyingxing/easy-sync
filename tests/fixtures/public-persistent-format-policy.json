      "compatibility": "read-only import; never a runtime writer"
    },
    {
      "id": "v2-file-state-envelope",
      "class": "authority",
      "owner": "src/sync/state-envelope-v2.ts",
      "currentVersion": 2,
      "compatibility": "strict read; compatible optional fields may be absent; breaking semantics require a new adjacent migration"
    },
    {
      "id": "v2-active-indexeddb",
      "class": "authority-storage",
      "owner": "src/sync/state-v2-indexeddb-active.ts",
      "currentVersion": 1,
