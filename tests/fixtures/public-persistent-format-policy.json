    "historicalMigrationFloor": "1.1.3",
    "unpublishedBuildsArePermanentInputs": false,
    "breakingChangesRequireAdjacentMigration": true,
    "ordinaryFeatureChangesRequireGlobalVersionBump": false
  },
  "versionAxes": {
    "pluginRelease": "manifest/package version only",
    "fileStateModel": "V2 planner, executor, envelope and recovery contract",
    "activeDatabaseSchema": "IndexedDB physical schema",
    "generationProtocol": "immutable remote generation lineage",
    "storageLayout": "device-local EasySync path contract",
    "featureState": "owner-specific schema or version"
  },
  "families": [
    {
      "id": "public-1.1.3-import",
      "class": "legacy-authority-input",
      "owner": "src/sync/public-1-1-3-state-import.ts",
