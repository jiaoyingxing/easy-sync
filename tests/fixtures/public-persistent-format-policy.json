    },
    {
      "id": "cloud-bootstrap-v2",
      "class": "remote-nonauthoritative-evidence",
      "owner": "src/sync/cloud-bootstrap-v2.ts",
      "currentVersion": 2,
      "acceptedNestedVersions": {
        "publicationCheckpoint": [1]
      },
      "compatibility": "strict per-item evidence only; failure falls back to canonical verification, never to guessed equality"
    },
    {
      "id": "community-plugin-participation",
      "class": "device-local-feature-authority",
      "owner": "src/sync/community-plugin-participation.ts",
      "currentVersion": 1,
      "compatibility": "stored inside the selected V2 envelope; not a cloud device roster"
    },
    {
      "id": "community-plugin-lifecycle-control",
      "class": "unpublished-remote-control-record",
      "owner": "src/sync/community-plugin-lifecycle-v1.ts",
      "currentVersion": 2,
      "status": "development-unpublished",
      "compatibility": "schema 1 remains readable observation-only input; explicit legacy migration confirmation upgrades it atomically to schema 2, which adds irreversible legacy-writer consent; neither version is attached to a public release profile"
    },
    {
      "id": "community-plugin-lifecycle-device-observation",
      "class": "unpublished-device-local-recovery-state",
      "owner": "src/sync/community-plugin-lifecycle-device-v1.ts",
      "currentVersion": 1,
      "status": "development-unpublished",
      "acceptedNestedVersions": {
        "observationCheckpoint": [1],
        "controlMutationCheckpoint": [1],
        "bundlePublicationCheckpoint": [1],
        "generationCleanupCheckpoint": [1]
      },
      "compatibility": "App-local identity plus separate response-unknown checkpoints for observation, bundle publication, generation cleanup and explicit generation join, legacy consent or seal control mutations; corruption or identity loss never transfers old-generation authority"
    },
    {
      "id": "v2-recovery-control-records",
      "class": "recovery-evidence",
      "owner": "src/sync/state-manager.ts",
      "currentVersion": "member-specific",
      "acceptedNestedVersions": {
        "fileMutationIntent": [1],
        "folderMutationIntent": [2],
        "communityPluginBundleSettlement": [2],
        "mutationReceipt": [1],
        "recoveryQuarantine": [2],
        "otherListedControlRecords": [1]
      },
      "acceptedOptionalSemantics": {
        "fileMutationIntentV1StateEffect": ["local-only", "settlement-only"]
      },
      "members": [
        "migration hold",
        "scope transition",
        "corrupt-state publication",
        "corrupt-state recovery hold",
        "mutation ledger and receipts",
        "IndexedDB recovery delta"
      ],
      "compatibility": "must be resumed, proven not to have occurred, or explicitly retired; never cleared as a cache; local-only and settlement-only effects do not publish ordinary files-root state; community-plugin bundle settlement is a versioned manual-resolution branch, so public 1.2.7 rejects the ledger instead of ignoring the whole-bundle choice"
    },
    {
      "id": "remote-scope-recovery-evidence-db",
      "class": "nonauthoritative-recovery-evidence",
      "owner": "src/sync/remote-scope-recovery-evidence-store.ts",
      "currentVersion": 1,
      "acceptedNestedVersions": {
        "operationRecord": [1, 2],
        "receipt": [1]
      },
      "compatibility": "physical database schema 1 keeps public remote-scope operation v1 readable and adds first-sync operation v2; receipts remain exact-version v1; loss only causes more verification and never authorizes a mutation"
    },
    {
      "id": "plugin-data-settings-and-local-intent",
      "class": "device-local-feature-state",
      "owner": "src/main.ts",
      "currentVersion": "versionless-keyed",
      "compatibility": "owner-specific defaults and one-way key migrations; never infer remote authority from absence"
    },
    {
      "id": "easy-sync-runtime-layout",
      "class": "device-local-storage-layout",
      "owner": "src/obsidian-compat.ts",
      "currentVersion": 2,
      "acceptedNestedVersions": {
        "legacyReadAndMigrationSource": [1]
      },
      "compatibility": "verified local copy then stable-round cleanup; not a remote protocol upgrade"
    },
    {
      "id": "rebuildable-caches-and-presentation",
      "class": "disposable-cache",
      "owner": "src/sync/state-manager.ts",
      "currentVersion": "owner-specific",
      "members": [
        "scan cache",
        "remote inventory cache",
        "community-plugin catalog and manifest observations",
        "profile cache",
        "sync history and progress presentation"
      ],
      "compatibility": "may be rebuilt only when it is not the sole evidence for a pending authority or mutation decision"
    }
  ],
