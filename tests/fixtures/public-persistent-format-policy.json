        "indexedDbStorageAuthority": [1, 2]
      },
      "compatibility": "single-direction CAS selection; schema 2 storage binding never falls back to schema 1"
    },
    {
      "id": "protocol-v2",
      "class": "remote-control-record",
      "owner": "src/sync/sync-protocol-v2.ts",
      "currentVersion": 2,
      "recordSchemaVersion": 1,
      "compatibility": "immutable read/create-only predecessor input"
    },
    {
      "id": "protocol-v3",
      "class": "remote-control-record",
      "owner": "src/sync/sync-protocol-v3.ts",
      "currentVersion": 3,
      "recordSchemaVersion": 1,
